# Copy this file to .env and fill in real values. Never commit .env itself.

# Local dev DB (SQLite file, created automatically by Prisma)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5500"

# PayPal (sandbox credentials for local dev — get from developer.paypal.com)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"

# Notifications (fill in when you wire these up — leave blank to no-op locally)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
WHATSAPP_API_TOKEN=""
